{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* ── Module path overrides ────────────────────────────────────────────── */
    // tough-cookie v6 ships separate ESM (.d.ts) and CJS (.d.cts) type
    // declarations.  With moduleResolution:node16, TypeScript resolves the ESM
    // declaration (.d.ts) for our source files and the CJS declaration (.d.cts)
    // for CJS-context packages such as @exhumer/undici-cookie-agent.  The two
    // declarations have incompatible private fields (the dual-package hazard),
    // causing a structural type error when our CookieJar is passed to
    // CookieAgent.  Pinning to the CTS declaration file makes both contexts
    // resolve the same declaration, eliminating the conflict.
    //
    // This override lives here rather than in tsconfig.json so that tsdown's
    // JS bundler, which reads tsconfig.json for module resolution, never sees
    // the redirect. The equivalent override for tsdown's declaration bundler
    // is declared in tsdown.config.ts under dts.compilerOptions.paths.
    "paths": {
      "tough-cookie": ["./node_modules/tough-cookie/dist/index.d.cts"]
    }
  }
}
