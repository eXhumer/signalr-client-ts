{
  "name": "@exhumer/signalr-client",
  "version": "2.0.0",
  "description": "ASP.NET Core SignalR client for Node.js",
  "type": "module",
  "author": {
    "name": "eXhumer",
    "email": "github@exhumer.cc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eXhumer/signalr-client-ts"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:package": "tsc -p tsconfig.package.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --reporter=junit --outputFile=test-report.junit.xml",
    "bench": "vitest bench",
    "bench:protocol": "vitest bench tests/bench/protocol.bench.ts",
    "bench:transport": "vitest bench tests/bench/transport.bench.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "signalr",
    "aspnetcore",
    "realtime",
    "websocket",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@vitest/coverage-istanbul": "^4.1.9",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@exhumer/undici-cookie-agent": "^2.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "tough-cookie": "^6.0.1",
    "undici": "^8.5.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
