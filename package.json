{
  "name": "@exhumer/signalr-client",
  "version": "1.0.0",
  "description": "ASP.NET Core SignalR client for Node.js",
  "type": "module",
  "author": {
    "name": "eXhumer",
    "email": "github@exhumer.cc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eXhumer/signalr-client-ts"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "error"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "bench:protocol": "vitest bench tests/bench/protocol.bench.ts",
    "bench:transport": "vitest bench tests/bench/transport.bench.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "signalr",
    "aspnetcore",
    "realtime",
    "websocket",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@exhumer/undici-cookie-agent": "^1.0.3",
    "@msgpack/msgpack": "^3.1.3",
    "tough-cookie": "^6.0.1",
    "undici": "^8.0.2"
  }
}
